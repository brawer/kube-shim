[Unit]
Description=Kubernetes API Shim
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/brawer/kube-shim:latest
# Auto-updates on every release via podman-auto-update.timer -- see
# docs/IMPLEMENTATION_PLAN.md Phase 3. This trades update-safety for
# development-loop speed: acceptable here specifically because UpCloud's
# billing is prepaid with no auto-recharge, so a bad release can burn at
# most the current prepaid balance, not an unbounded card charge.
#
# For a deployment without that backstop, prefer the safer, deliberate
# alternative instead: pin an explicit version (e.g.
# Image=ghcr.io/brawer/kube-shim:v0.1.0), remove the AutoUpdate= label
# below, and update by hand: `podman pull` + `systemctl --user restart`.
AutoUpdate=registry
Volume=%h/kube-shim-data:/data:Z
# Asymmetric host:container port mappings, not host:same-port -- verified
# hands-on against the real kube-shim.brawer.ch deployment (Phase 4):
# rootless podman's rootlessport *can* publish a host port <1024 once
# net.ipv4.ip_unprivileged_port_start is lowered on the host (see
# bootstrap/provision.sh), but that sysctl doesn't reach into the
# container's own network namespace -- the shim process itself, running
# as non-root UID 1000, still can't bind <1024 there directly. So the
# container keeps listening on unprivileged ports internally (matching
# config.toml's server.port / server.acme_challenge_port), and only the
# host-side publish uses the real, public 443/80.
PublishPort=443:8443
PublishPort=80:8080

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
